                        <p>Samwise</p>

                    </section>
                    <section class="avatar-item">
                        <img src="../assets/images/imageC/character_saruman-Photoroom.png" alt="Saruman" onclick="selectAvatar('/assets/images/imageC/character_saruman-Photoroom.png')" />
                        <p>Saruman</p>

                    </section>
                    <section class="avatar-item">
                        <img src="../assets/images/imageC/character_sauron-Photoroom.png" alt="sauron" onclick="selectAvatar('/assets/images/imageC/character_sauron-Photoroom.png')" />
                        <p>Sauron</p>

                    </section>
                    <section class="avatar-item">
                        <img src="../assets/images/imageC/character_théodon-Photoroom.png" alt="Theodon" onclick="selectAvatar('/assets/images/imageC/character_théodon-Photoroom.png')" />
