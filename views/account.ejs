<!DOCTYPE html>
<html lang="nl-BE">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="assets/images/logo.png" />
    <title>Lord Of The Rings - Account</title>
    <link rel="stylesheet" href="css/reset.css">
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="js/account.js" defer></script>

   
    
</head>

<body class="account">
    <header>
        <a class="logo" href="landing">
            <img src="assets/images/logo.png" alt="logo" width="100px" id="logo">
        </a>
        <nav class="nav-bar">
            <ul>
                <li><a href="index">Home</a></li>
                <li><a href="favorites">Favorieten</a></li>
                <li><a href="blacklist">Zwartelijst</a></li>
                <li class="login-icon">
                    <a href="account" class="login-icon">
                        <i class="fas fa-user-circle" style="font-size: 30px; "></i> 
                    </a>
                </li>
            </ul>
        </nav>
    </header>
    <main>
        <section class="profile-container">
            <section class="profile-photo" onclick="openAvatarSelection();">
                <img id="avatar" src="assets/images/character_aragorn.png" />
                <p class="avatar-text">Kies Avatar</p>
            </section>
            <section class="profile-info">
                <input type="text" id="username" placeholder="Naam" required />
                <input type="text" id="level" value="Level: 5 (XP: 1200)" readonly />
                <textarea id="bio" placeholder="Bio"></textarea>

                <h2>Gewonnen games</h2>
                <section class="won-games">
                    <p>Quiz: <span id="quiz-wins">4</span> </p>
                    <p>Sudden-death: <span id="sudden-death-wins">2</span></p>
                    <p>Ten rounds: <span id="ten-rounds-wins">1</span></p>
    

                </section>

                <section class="save-button">
                    <button onclick="save()">save</button>

                </section>


            <section>
        </section>
    
    
        
        <section id="avatar-modal" class="modal">
            <section class="modal-content">
                <span class="close" onclick="closeAvatarSelection()">&times;</span>
                <h2>Kies jouw Avatar</h2>
                <section class="avatar-list">
                    
                    <section class="avatar-item">
                        <img src="../assets/images/imageC/character_aragorn.png" alt="Aragon"  onclick="selectAvatar('/assets/images/imageC/character_aragorn.png')" />
                        <p>Aragon</p>
                    </section>
                    <section class="avatar-item">
                        <img src="../assets/images/imageC/character_galadriel-Photoroom.png" alt="Galadriel" onclick="selectAvatar('/assets/images/imageC/character_galadriel-Photoroom.png')" />
                        <p>Galadriel</p>

                    </section>
                    <section class="avatar-item">
                        <img src="../assets/images/imageC/character_gollum-Photoroom.png" alt="Gollum" onclick="selectAvatar('/assets/images/imageC/character_gollum-Photoroom.png')" />
                        <p>Gollum</p>

                    </section>
                    <section class="avatar-item">
                        <img src="../assets/images/imageC/character_bilbo-Photoroom.png" alt="Bilbo" onclick="selectAvatar('/assets/images/imageC/character_bilbo-Photoroom.png')" />
                        <p>Bilbo</p>

                    </section>
                    <section class="avatar-item">
                        <img src="../assets/images/imageC/character_boromir-Photoroom.png" alt="Boromir" onclick="selectAvatar('/assets/images/imageC/character_boromir-Photoroom.png')" />
                        <p>Boromir</p>

                    </section>
                    <section class="avatar-item">
