                    </section>
                    <section class="avatar-item">
                        <img src="assets/images/bilbo baggins.png" alt="Bilbo" onclick="selectAvatar('assets/images/bilbo baggins.png')" />
                        <p>Bilbo</p>

                    </section>
                    <section class="avatar-item">
                        <img src="assets/images/bormir.png" alt="Boromir" onclick="selectAvatar('assets/images/bormir.png')" />
                        <p>Boromir</p>

                    </section>
                    <section class="avatar-item">
