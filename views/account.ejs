                        <p>Eowyn</p>

                    </section>
                    <section class="avatar-item">
                        <img src="../assets/images/imageC/character_faramir-Photoroom.png" alt="Faramir" onclick="selectAvatar('/assets/images/imageC/character_faramir-Photoroom.png')" />
                        <p>Faramir</p>

                    </section>
