                    </section>
                    <section class="avatar-item">
                        <img src="assets/images/treebeard.png" alt="Treebeard" onclick="selectAvatar('assets/images/treebeard.png')" />
                        <p>Treebeard</p>

                    </section>

                    
                <section>
            <section>
        <section>
    
    </main>
