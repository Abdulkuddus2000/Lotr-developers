                    </section>
                    <section class="avatar-item">
                        <img src="../assets/images/imageC/character_treebeard-Photoroom.png" alt="Treebeard" onclick="selectAvatar('/assets/images/imageC/character_treebeard-Photoroom.png')" />
                        <p>Treebeard</p>

                    </section>
                <section>
            <section>
        <section>
    
    </main>
    <footer class="footer-blacklist">
        <p>&copy;2025 AP-Hogeschool | Kosimov Abdul, Habrani Nabil en Hamse Mohammed Yassin</p>
