                    </section>
                    <section class="avatar-item">
                        <img src="assets/images/frodo.png" alt="Frodo" onclick="selectAvatar('assets/images/frodo.png')" />
                        <p>Frodo</p>

                    </section>
                    <section class="avatar-item">
                        <img src="assets/images/gandalf.png" alt="Gandalf" onclick="selectAvatar('assets/images/gandalf.png')" />
