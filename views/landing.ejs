                    </a>
                </section>
                <section class="game game4"><a href="#" onclick="ShowAlert()">
                        <p>LegoMasters</p>
                    </a>
                </section>
                <section class="game game5"><a href="#" onclick="ShowAlert()">
                        <p>MTG</p>
                    </a>
                </section>
                <section class="game game6"><a href="#" onclick="ShowAlert()">
                        <p>Pokemon</p>
                    </a>
                </section>
            </section>
        </section>
    </main>
    <footer class="footer-landing">
        &copy; Copyright WPL Projects 2024-2025 - by Abdul Kosimovs, Nabil Habrani en Hamse Mohamed Yassin
