<%- include('partials/head') %>
<body class="landingPage">
    <section class="customAlert">
        <section class="alert-content">
            <h2>Geen toegang!</h2>
            <p>Dit spel is jammer genoeg niet beschikbaar (maar LOTR wel ...)</p>
            <button onclick="HideAlert()" class="customAlertButton">Begrepen</button>
        </section>
    </section>
    <main>
        <section class="gameChoice">
            <h2>Maak uw keuze</h2>
        </section>
        <section class="games-list">
            <section class="games">
                <section class="game game1">
                    <a href="login">
                        <p class="neonText">LOTR</p>
                    </a>
                </section>
                <section class="game game2">
                    <a href="#" onclick="ShowAlert()">
                        <p class="neonText">FIFA</p>
                    </a>
                </section>
                <section class="game game3"><a href="#" onclick="ShowAlert()">
                        <p class="neonText">FORTNITE</p>
                    </a>
                </section>
                <section class="game game4"><a href="#" onclick="ShowAlert()">
                        <p class="neonText">LEGOMASTER</p>
                    </a>
                </section>
                <section class="game game5"><a href="#" onclick="ShowAlert()">
                        <p class="neonText">MTG</p>
                    </a>
                </section>
                <section class="game game6"><a href="#" onclick="ShowAlert()">
                        <p class="neonText">POKEMON</p>
                    </a>
                </section>
            </section>
        </section>
    </main>
    <script src="/js/general.js"></script>
</body>
</html>