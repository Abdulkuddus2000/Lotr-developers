<%- include("partials/head")%>
<body class="resetPassword">
    <%- include("partials/logo") %>
    <main>
        <form method="post">
            <h2>Herstel je wachtwoord</h2>
            <label for="resetPassword1">Geef enieuwe wachtwoord in:</label>
            <input type="password" name="resetPassword1" id="resetPassword1" placeholder="*****">
            <i class="fa fa-eye eyeIcon eyeIcon1" onmousedown="togglePasswordOnMouseDown(event)"
                onmouseup="togglePasswordOnMouseUp(event)"></i>
            <br>

            <label for="resetPassword2">Bevestig nieuwe wachtwoord:</label>
            <input type="password" name="resetPassword2" id="resetPassword2" placeholder="*****">
            <i class="fa fa-eye eyeIcon eyeIcon1" onmousedown="togglePasswordOnMouseDown(event)"
                onmouseup="togglePasswordOnMouseUp(event)"></i>

            <button type="submit" id="submitResetPassword">Herstel wachtwoord</button>
        </form>
    </main>
</body>
</html>
<%- include("partials/footer")%>