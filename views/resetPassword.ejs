<%- include("partials/head")%>
<body class="resetPassword-page">
    <%- include("partials/logo") %>
    <main>
        <form method="post">
            <h2>Herstel je wachtwoord</h2>
            <section class="form-resetPassword">
                <label for="resetPassword1">Geef uw nieuw wachtwoord in:</label>
                <input type="password" name="resetPassword1" id="resetPassword1" placeholder="*****">
                <i class="fa fa-eye eyeIcon eyeIcon1" onmousedown="togglePasswordOnMouseDown(event)"
                    onmouseup="togglePasswordOnMouseUp(event)">
                </i>
            </section>
            <section class="form-resetPassword">
                <label for="resetPassword2">Bevestig uw nieuw wachtwoord:</label>
                <input type="password" name="resetPassword2" id="resetPassword1" placeholder="*****">
                <i class="fa fa-eye eyeIcon eyeIcon1" onmousedown="togglePasswordOnMouseDown(event)"
                    onmouseup="togglePasswordOnMouseUp(event)">
                </i>
            </section>

            <button type="submit" id="submitResetPassword">Herstel wachtwoord</button>
        </form>
    </main>
</body>
<%- include("partials/footer")%>