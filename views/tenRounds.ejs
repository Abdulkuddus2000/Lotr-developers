<%- include('partials/head') %>
<body class="lotr-quiz">
    <%- include('partials/nav') %>
    <section class="info-rulesButton">
        <button id="spelregelsButton" class="spelregels-button" onclick="document.getElementById('quizRulesAlert').style.display='flex'">
            <i class="fas fa-question-circle"></i> Spelregels
        </button>
    </section>
    <section class="customAlertQuiz" id="quizRulesAlert">
        <section class="alert-contentQuiz">
            <h2>tenRounds</h2>
            <ul class="rules-list">
                <li>Beantwoord beide vragen goed om een punt te krijgen</li>
                <li>Je hebt 10 rondes in totaal</li>
                <li>Je score is het aantal rondes dat je correct beantwoordt</li>
                <li>Gebruik duimen omhoog om je favoriete citaten te markeren</li>
                <li>Gebruik duimen omlaag om eventuele problemen met citaten te melden</li>      
            </ul>
            <button onclick="document.getElementById('quizRulesAlert').style.display='none'">verder</button>
        </section>
    </section>
    <main id="quizMain">
        <section id="quizContent">
           <form action="/checkAnswerCard" method="POST" class="checkAnswerCard-form">
                <input type="hidden" name="randomQuote" value='<%= JSON.stringify(randomQuote) %>'>
                <input type="hidden" name="score" value='tenRounds'>

                <section class="quiz-header">
                    <h1 class="quiz-title">Ten Rounds</h1>
                    <section class="quiz-progress">
                        <span class="current-round"> <%= counter %> / 10</span>
                        <span class="current-score">Score: <%= score %></span>
                    </section>
                </section>

                <section class="quote-random">
                    <section class="quote-box">
                        <p class="quote-text">"<%= randomQuote.dialog %>"</p>
                    </section>
                </section>
                    <section class="quizQuestions">
                        <h3>Wie zei deze quote?</h3>
                        <section class="quizFlex">
                            <% characterOptions.forEach((character, index) => { %>
                            <section class="character-option">
                                    <input type="radio" id="character-<%= index %>" name="nameAnswer" value="<%= character.name %>" required>
                                    <label for="character-<%= index %>" class="character-label">
                                        <span class="character-name"><%= character.name %></span>
                                    </label>
                            </section>
                            <% }) %>
                        </section>
                    </section>

                    <section class="quizQuestions">
                        <h3>In welke film komt deze quote voor?</h3>
                        <section class="quizFlex">
                            <% movies.forEach((movie, index) => { %>
                                <section class="movie-option">
                                    <input type="radio" id="movie-<%= index %>" name="movieAnswer" value="<%= movie.title %>" required>
                                    <label for="movie-<%= index %>" class="movie-label">
                                        <span class="movie-title"><%= movie.title %></span>
                                    </label>
                                </section>
                            <% }) %>
                        </section>
                    </section>
                </section>

                <section>
                    <button type="submit" id="quizButton" class="quiz-button">Volgende vraag</button>
                </section>
                    <section class="thumbs-actions">
                        <form action="/thumbsUpDown" method="POST" class="thumbs-form">
                            <input type="hidden" name="quoteData" value='<%= JSON.stringify(randomQuote) %>'>
                            <input type="hidden" name="mode" value="tenRounds">
                            <button type="submit" class="fas fa-thumbs-up" title="Favoriet-toevoegen"></button>
                            <button type="button" class="fas fa-thumbs-down" title="Quote-blacklisten" onclick="openBlacklistModal()"></button>
                        </form>
                    </section>
                </section>
            </form>
        </section> 
    </main>
</body>
</html>
<%- include('partials/footer') %>




  