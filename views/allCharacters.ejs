<!DOCTYPE html>
<html lang="nl-BE">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="assets/images/logo.png" />
    <title>Lord Of The Rings - Alle Lotr karacters</title>
    <link rel="stylesheet" href="css/reset.css">
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body class="allCharacters">
    <header>
        <a class="logo" href="index">
            <img src="assets/images/logo.png" alt="logo" width="100px" id="logo">
        </a>
        <nav>
            <ul>
                <li><a href="index">Home</a></li>
                <li class="dropdown_li"><a href="characters">Karakters</a>
                    <ul class="dropdown_li_content">
                        <li><a href="allCharacters">Alle karakters</a></li>
                        <li><a href="favorites">Favorieten</a></li>
                        <li><a href="blacklist">Zwartelijst</a></li>
                    </ul>
                </li>
                <li class="login-icon">
                    <a href="account" class="login-icon">
                        <i class="fas fa-user-circle" style="font-size: 30px;"></i> 
                    </a>
                </li>
            </ul>
        </nav>
    </header>

    <!-- <pre><%= JSON.stringify(characters, null, 2) %></pre> -->

    <main>
        <% characters.forEach(function(character) { %>
            <h1><%= character.name %></h1>
            <h1><%= character %></h1>
            <!-- <img src="<%= character.imageUrl %>" alt="<%= character.name %>" style="width:200px;height:auto;"> -->
            
            <h2>Quotes (<%= character.quotes.length %>)</h2>
            <ul>
                <% character.quotes.forEach(function(quote) { %>
                    <li><%= quote %></li>
                <% }); %>
            </ul>
        <% }); %>
    </main>

    <footer>
        <p>&copy;2024 AP-Hogeschool | Kosimov Abdul, Habrani Nabil, Tukka Hakki en Molov Metin</p>
        <a href="#" class="back-to-top">
            <i class="fas fa-chevron-circle-up"></i>   
        </a>
    </footer>
</body>

</html>