
<%- include('partials/head') %>
<body class="lotr-quiz">
    <%- include('partials/nav') %>
    <section class="info-rulesButton">
        <button id="spelregelsButton" class="spelregels-button" onclick="document.getElementById('quizRulesAlert').style.display='flex'">
            <i class="fas fa-question-circle"></i> Spelregels
        </button>
    </section>
    <section class="customAlertQuiz" id="quizRulesAlert">
        <section class="alert-contentQuiz">
            <h2>Sudden Death</h2>
            <ul class="rules-list">
                <li>Per goede combinatie krijg je 1 punt.</li>
                <li>Bij een fout half antwoord stopt het spel.</li>
                <li>Je krijgt te zien hoeveel vragen je na elkaar goed had.</li>
                <li>Je kunt zien wat de high score was.</li>
                <li>Gebruik duimen omhoog om je favoriete citaten te markeren.</li>
                <li>Gebruik duimen omlaag om eventuele problemen met citaten te melden.</li>
            </ul>
            <button onclick="document.getElementById('quizRulesAlert').style.display='none'">verder</button>
        </section>
    </section>
    <main id="quizMain">
        <section id="quizContent">
           <form action="/checkAnswerCard" method="POST" class="checkAnswerCard-form">
                <input type="hidden" name="randomQuote" value='<%= JSON.stringify(randomQuote) %>'>
                <input type="hidden" name="score" value='suddenDeath'>

                <section class="quiz-header">
                    <h1 class="quiz-title">Sudden Death</h1>
                </section>

                <section class="quote-random">
                    <section class="quote-box">
                        <p class="quote-text">"<%= randomQuote.dialog %>"</p>
                    </section>
                </section>
                    <section class="quizQuestions">
                        <h3>Wie zei deze quote?</h3>
                        <section class="quizFlex">
                            <section class="character-option">
                                <input type="radio" id="answer1" name="nameAnswer" value="<%= A1.answer1 %>" required>
                                <label for="answer1" class="character-label">
                                    <span class="character-name"><%= A1.answer1 %></span>
                                </label>
                            </section>
                            <section class="character-option">
                                <input type="radio" id="answer2" name="nameAnswer" value="<%= A2.answer2 %>" required>
                                <label for="answer2" class="character-label">
                                    <span class="character-name"><%= A2.answer2 %></span>
                                </label>
                            </section>
                            <section class="character-option">
                                <input type="radio" id="answer3" name="nameAnswer" value="<%= A3.answer3 %>" required>
                                <label for="answer3" class="character-label">
                                    <span class="character-name"><%= A3.answer3 %></span>
                                </label>
                            </section>
                        </section>
                    </section>

                    <section class="quizQuestions">
                        <h3>In welke film komt deze quote voor?</h3>
                        <section class="quizFlex">
                            <% movies.forEach((movie, index) => { %>
                                <section class="movie-option">
                                    <input type="radio" id="movie-<%= index %>" name="movieAnswer" value="<%= movie.title %>" required>
                                    <label for="movie-<%= index %>" class="movie-label">
                                        <span class="movie-title"><%= movie.title %></span>
                                    </label>
                                </section>
                            <% }) %>
                        </section>
                    </section>
                </section>

                <section>
                    <button type="submit" id="quizButton" class="quiz-button">Volgende vraag</button>
                </section>
            </form>
            <section class="thumbs-section">
                <form action="/thumbsUpDown" method="POST" style="display: inline;">
                    <textarea name="quoteData" style="display: none;"><%- JSON.stringify(randomQuote) %></textarea>
                    <input type="hidden" name="mode" value="suddenDeath">
                    <input type="hidden" name="action" value="up">
                    <button type="submit" class="fas fa-thumbs-up" title="voeg favorites">👍</button>
                </form>
                
                <form action="/thumbsUpDown" method="POST" style="display: inline;">
                    <textarea name="quoteData" style="display: none;"><%- JSON.stringify(randomQuote) %></textarea>
                    <input type="hidden" name="mode" value="suddenDeath">
                    <input type="hidden" name="action" value="down">
                    <button type="submit" class="fas fa-thumbs-down" title="voeg blacklist">👎</button>
                </form>
            </section>
    </section> 
    </main>
</body>
</html>
<%- include('partials/footer') %>
<%- include('partials/chevronUp') %>
