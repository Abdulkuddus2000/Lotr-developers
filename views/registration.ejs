<head>

    <link rel="stylesheet" href="css/reset.css">
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <script src="registration.ejs" defer></script>
</head>
<body class="registration-page">
   <figure class="regi_logo">
       <a href="/">
           <img src="assets/images/logo.png" alt="logo Lord Of The Rings" height="100px">
       </a>
   </figure>
   <main class="mainRegistration">
    <section class="registration-clean">
        <form class="register-form" method="post">
            <h2 class="h2-Registration">Registreer</h2>
            <section class="form-registration">
                <label for="firstname">Gebruikersnaam:</label>
                <input type="text" id="usernameRegistrationPage" name="username" placeholder="" required>
                <br>
            </section>
            <section class="form-registration">
                <label for="password">Wachtwoord:</label>
                <input type="password" id="passwordRegistrationPage" name="password" placeholder="*****" required>
                <i class="fa fa-eye eyeIcon eyeIcon1" onmousedown="togglePasswordOnMouseDown(event)"
                onmouseup="togglePasswordOnMouseUp(event)"></i>
                <br>
            </section>
            <section class="form-registration">
                <label for="confirm-password">Bevestig uw wachtwoord:</label>
                <input type="password" id="passwordRegistrationPage" name="confirm-password" placeholder="*****" required>
                <i class="fa fa-eye eyeIcon eyeIcon1" onmousedown="togglePasswordOnMouseDown(event)"
                    onmouseup="togglePasswordOnMouseUp(event)"></i>
                <br>
            </section>           
            <button type="submit" class="regiButton">Bevestigen</button>
        </form>
    </section>
    </main>
    <script src="../js/iconEyes.js"></script>
</body>
    <%- include("partials/footer")%>
