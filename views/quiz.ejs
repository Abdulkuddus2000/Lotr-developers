<!DOCTYPE html>
<html lang="nl-BE">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="assets/images/logo.png" />
    <title>Lord Of The Rings - Quiz</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="css/reset.css">
    <link rel="stylesheet" href="css/style.css">
    <script defer src="js/quiz.js"></script>
</head>
<body class="quiz">
    <header>
        <figure>
            <a href="index.html">
                <img src="assets/images/logo.png" alt="logo Lord Of The Rings" height="100px">
            </a>
        </figure>
        <nav>
            <ul>
                <li><a href="index.html">Home</a></li>
                <li><a href="favorites.html">Favorieten</a></li>
                <li><a href="blacklist.html">Zwarte lijst</a></li>
            </ul>
        </nav>
    </header>
    <main class="container text-center my-5">
        <h2>QUİZ</h2>
        <br>
        <section class="quiz-box p-4 rounded">
            <div class="question-box p-3 mb-3">
                <p id="question-text"></p>
            </div>
            <div class="row">
                <article class="col-md-4" id="col-md-4">
                    <br>
                <div class="option-card">
                    <img class="quiz-option" src="" alt="option1">
                </div>
                </article>
                <article class="col-md-4" id="col-md-4">
                    <br>
                    <div class="option-card">
                        <img class="quiz-option" src="" alt="option2">
                    </div>
                </article>
                <article class="col-md-4" id="col-md-4">
                    <br>
                    <div class="option-card">
                        <img class="quiz-option" src="" alt="option3">
                    </div>
                </article>
            </div>
            <br>
            <button class="btn btn-secondary mt-4" id="fav-btn">FAV</button>
            <button class="btn btn-secondary mt-4" id="next-btn">NEXT</button>
            <button class="btn btn-secondary mt-4" id="blacklist-btn" onclick="openPopup()">BLACK</button>
        </section>
    </main>
    <aside id="popup" class="popup">
        <div class="popup-content">
          <span class="close" onclick="closePopup()">&times;</span>
          <h3>Reden voor blacklist</h3>
          <textarea id="reason" placeholder="UW REDEN..."></textarea>
          <button onclick="submitReason()">SEND</button>
        </div>
      </aside>
    <br>
    <footer>
        &copy; Copyright WPL Projects 2024-2025
    </footer>
</body>
</html>
