
<%- include('partials/head') %>
<body class="score-page">
    <main id="scoreQuiz">
        <h1 id="scoreH1">Bedankt voor het meedoen!</h1>
        <ul id="scoreListFlex">
            <section class="yourScore">
                Jouw streak is<br>
                <span class="score-number"><%= streak %></span>
            </section>
            <section id="result">
                <% if (finalScore >= 8) { %>
                    <section class="gold-medal">🥇</section>
                    <p class="medal-text">GOUD</p>
                <% } else if (finalScore >= 5) { %>
                    <section class="silver-medal">🥈</section>
                    <p class="medal-text">ZILVER</p>
                <% } else if (finalScore >= 3) { %>
                    <section class="bronze-medal">🥉</section>
                    <p class="medal-text">BRONS</p>
                <% } else { %>
                    <section class="try-again">😩</section>
                    <p class="medal-text">Probeer nog eens</p>
                <% } %>
            </section>
            <li class="yourScore">hoogste score<br><span class="score-number"><%= highScore %></span></li>
        </ul>
        <a href="/index"><button id="scoreButton">Hoofdmenu</button></a>
    </main>
    <%- include('partials/footer') %>
</body>
</html>