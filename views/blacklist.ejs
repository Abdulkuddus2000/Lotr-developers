<%- include('partials/head') %>
<%- include('partials/nav') %>
<main class="main-blacklist">
    <h2 class="title-blacklist">Zwartelijst</h2>
    <% if (blacklistedQuotes && blacklistedQuotes.length > 0) { %>
        <% blacklistedQuotes.forEach(entry => { %>
            <section class="blacklist-item">
                <span>"<%= entry.quote.dialog %>" - <%= entry.quote.character_name || 'Character' %></span>
                <section class="icon-edit">
                    <a href="#" class="icon-edit" onclick="openEditModal('<%= entry.blacklistId %>', '<%= entry.reason %>', '<%= entry.quote.dialog %>')">
                        <i class="fa fa-cog"></i>
                    </a>
                    <a href="#" class="icon-edit" onclick="openDeleteModal('<%= entry.blacklistId %>')">
                        <i class="fas fa-trash"></i>
                    </a>
                </section>
            </section>
        <% }); %>
    <% } else { %>
        <section class="blacklist-item">
            <span>Je hebt nog geen quotes geblacklist. Ga naar de quiz en gebruik de thumbs down button.</span>
        </section>
    <% } %>
    <section id="quoteModal" class="modal-1">
        <article class="modal-blacklist">
            <span class="close" onclick="closeModal()">&times;</span>
            <h2 id="quoteTitle">Quote Reden Aanpassen</h2>
            <p id="quoteText" class="quote-text"></p>
            
            <form id="editReasonForm" action="/updateBlacklistReason" method="POST">
                <input type="hidden" id="editBlacklistId" name="blacklistId" value="">
                <input type="text" id="editQuote" name="newReason" placeholder="Voer nieuwe reden in" class="edit-input">
                <button type="submit" id="saveQuote" class="save-button">Opslaan</button>
            </form>
        </article>
    </section>
    
    <section id="confirmDeleteModal" class="modal-1">
        <article class="modal-blacklist">
            <span class="close" onclick="closeConfirmDeleteModal()">&times;</span>
            <h2>Bevestiging</h2>
            <p>Ben je zeker dat je de quote wilt verwijderen uit blacklist?</p>
            
            <form id="deleteForm" action="/removeFromBlacklist" method="POST">
                <input type="hidden" id="deleteBlacklistId" name="blacklistId" value="">
                <button type="submit" id="confirmDelete" class="confirm-button">Ja</button>
                <button type="button" id="cancelDelete" class="cancel-button" onclick="closeConfirmDeleteModal()">Nee</button>
            </form>
        </article>
    </section>
</main>
<script src="/js/blacklist.js"></script>
<%- include('partials/chevronUp') %>
