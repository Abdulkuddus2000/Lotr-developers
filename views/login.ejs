<%- include("partials/head")%>
<body class="login-page">
    <%- include("partials/logo")%>
    <main>
        <section class="login-clean">
            <form method="post">
                <h2 class="sr-only">Login Form</h2>
                <section class="illustration">
                    <h1 class="L">LOGİN</h1> 
                </section>
                <section class="form-group">
                    <input class="form-control" type="text" name="username" placeholder="Username">
                </section>
                <section class="form-group">
                    <input class="form-control" type="password" name="password" placeholder="Password">
                    <i class="eyeIcon" onmousedown="togglePasswordOnMouseDown(event)"
                onmouseup="togglePasswordOnMouseUp(event)"></i>
                <br>
                </section>
                <section class="login-group">
                    <button class="login-button" type="submit">Login</button>
                    <script src="index"></script>
                </section>
                <section class="form-group">
                    <a href="registration" class="register">Account aanmaken</a>
                </section>
                <section class="form-group">
                    <a href="forgetPassword" class="forgot">Wachtwoord vergeten?</a>
                </section>
            </form>
        </section>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.1.3/js/bootstrap.bundle.min.js"></script>
    </main>
</body>
<%- include("partials/footer")%>