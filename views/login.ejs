<%- include("partials/head")%>
<body class="login-page">
    <%- include("partials/logo")%>
    <main>
        <section class="login-clean">
            <form method="post">
                <h2 class="sr-only">Login Form</h2>
                <section class="illustration">
                    <h1 class="L">LOGİN</h1> 
                </section>
                <section class="form-group">
                    <label class="login-label" for="username">Gebruikersnaam:</label>
                    <input id="username" type="username" name="username" placeholder="Username">
                </section>
                <section class="form-group">
                    <label class="login-label" for="password">Wachtwoord:</label>
                    <input id="password" type="password" name="password" placeholder="Password">
                </section>
                <section class="form-group">
                    <button class="btn btn-primary btn-block" type="submit">Login</button>
                    <script src="index"></script>
                </section>
                <section class="form-group">
                    <a href="registration" class="register">Account aanmaken</a>
                </section>
            </form>
        </section>
    </main>
</body>
<%- include("partials/footer")%>