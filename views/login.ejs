<body>
    <figure class="login_logo">
        <a href="/">
            <img src="assets/images/logo.png" alt="logo Lord Of The Rings" height="100px">
        </a>
    </figure>
    
    <main>
        <section class="login-clean">
            <form method="post">
                <h2 class="sr-only">Login Form</h2>
                <section class="illustration">
                    <h1 class="L">LOGİN</h1>
                </section>
                <section class="form-group">
                    <input id="username" type="text" name="username" placeholder="Gebruikersnaam">
                </section>
                <section class="form-group">
                    <input id="password" type="password" name="password" placeholder="Wachtwoord">
                </section>
                <section class="form-group">
                    <button class="logButton" type="submit">Login</button>
                </section>
                <section class="form-group">
                    <a href="registration" class="register">Account aanmaken</a>
                </section>
            </form>
        </section>
    </main>
