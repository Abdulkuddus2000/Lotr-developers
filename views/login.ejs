<!DOCTYPE html>
<html lang="nl-BE">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lord Of The Rings - Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.1.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="css/reset.css">
    <link rel="stylesheet" href="css/style.css">
</head>
<body class="login">
    <header>
        <figure>
            <a href="landing">
                <img src="assets/images/logo.png" alt="logo Lord Of The Rings" height="100px">
            </a>
        </figure>
    </header>
    <main>
        <section class="login-clean">
            <form method="post">
                <h2 class="sr-only">Login Form</h2>
                <section class="illustration">
                    <h1 class="L">LOGİN</h1> 
                </section>
                <section class="form-group">
                    <input class="form-control" type="text" name="username" placeholder="Username">
                </section>
                <section class="form-group">
                    <input class="form-control" type="password" name="password" placeholder="Password">
                </section>
                <section class="form-group">
                    <button class="btn btn-primary btn-block" type="submit">Login</button>
                </section>
                <section class="form-group">
                    <a href="registration" class="register">Account aanmaken</a>
                </section>
                <section class="form-group">
                    <a href="resetPassword" class="forgot">Wachtwoord vergeten?</a>
                </section>
            </form>
        </section>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.1.3/js/bootstrap.bundle.min.js"></script>
        
    </main>
    <footer class="footer-login">
        &copy; Copyright WPL Projects 2024-2025 - Abdul Kosimov, Hakki Turaç, Nabil Habrani en Hamse Mohammed Yassin
    </footer>

</body>
</html>