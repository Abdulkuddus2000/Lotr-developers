<%- include('partials/head') %>
<%- include('partials/nav') %>
<main class="favoriteQuotes">
    <h1 class="favoritesH1">Favorieten quotes</h1>
    <hr>
    <% if (favoriteQuotes && favoriteQuotes.length > 0) { %>
        <section class="buttons">
            <a href="/exportFavorites" class="favoritesButton">Exporteren naar tekstbestand</a>
        </section>
        
        <section class="quotes">
            <% favoriteQuotes.forEach(quote => { %>
                <section class="quoteDetail">
                    <article class="quoteContent">
                        <article class="quoteHeader">
                            <h3 class="quoteCharacter">
                                <a href="https://lotr.fandom.com/wiki/<%= quote.character_name.replace(/\s+/g, '_') %>" target="_blank">
                                    <%= quote.character_name %>
                                </a>
                            </h3>
                            <p class="quoteMovie">Uit de film: <%= quote.movie_name %></p>
                        </article>
                        <blockquote class="quoteText">
                            "<%= quote.dialog %>"
                        </blockquote>
                        <form action="/deleteFavorite" method="POST" class="formDeleteFav">
                            <input type="hidden" name="quoteId" value="<%= quote._id %>">
                            <button type="submit" class="deleteFavorite">Verwijderen</button>
                        </form>
                    </article>
                </section>
            <% }); %>
        </section>
    <% } else { %>
        <p class="noFavorites">Je hebt nog geen favoriete quotes. Ga naar de quiz en gebruik de thumbs down button.</p>
    <% } %>
</main>
<%- include('partials/chevronUp') %>
<%- include('partials/footer') %>