<%- include('partials/head.ejs') %>
<%- include('partials/nav.ejs') %>

<main class="main-favorites">
    <h2>Je favoriete karakters</h2>
    <section class="quotes-favorites">
        <section class="favoriet">
            <h3>Favoriete quotes</h3>
            <p>Hieronder staan je favoriete quotes.</p>
            <% quotesData.docs.forEach(function(quote) { %>
                <p><strong>Character ID <%= quote.character %>:</strong> <%= quote.dialog %></p>
            <% }); %>
        <section class="favorites-buttons">
            <button class="favoriete-delete" onclick="deleteQuotes">Verwijderen</button>
            <button class="favoriete-print" onclick="printQuotes"> afprinten</button>
        </section>
    </section>
</main>
<%- include('partials/footer.ejs') %>*