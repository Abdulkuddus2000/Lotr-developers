<!DOCTYPE html>
<html lang="nl-BE">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="assets/images/logo.png" />
    <title>Lord Of The Rings - Quiz</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="css/reset.css">
    <link rel="stylesheet" href="css/style.css">
    <script defer src="js/quiz.js"></script>
</head>

<body class="sudden-death">
    <header>
        <figure>
            <a href="index">
                <img src="assets/images/logo.png" alt="logo Lord Of The Rings" height="100px">
            </a>
        </figure>
        <nav>
            <ul>
                <li><a href="index">Home</a></li>
                <li><a href="favorites">Favorieten</a></li>
                <li><a href="blacklist">Zwarte lijst</a></li>
            </ul>
        </nav>
    </header>
    <main id="quizMain">
        <section id="quizLeft">
            <form action="suddenMode" method="POST">
                <input type="hidden" name="randomQuote" value=''>
                <ul id="quizQuestionsflex">
                    <h1 id="suddenH1">Ten rounds</h1>
                    <li class="quizQuestionsitem1"></li>
                    <li class="quizItem">
                        <ul class="quizFlex">
                            <li class="quizAnswer">
                                <input type="radio" id="answer1" name="nameAnswer" value="">
                                <label for="answer1" class="radio"></label>
                            </li>
                            <li class="quizAnswer">
                                <input type="radio" id="answer2" name="nameAnswer" value="">
                                <label for="answer2" class="radio"></label>
                            </li>
                            <li class="quizAnswer">
                                <input type="radio" id="answer3" name="nameAnswer" value="">
                                <label for="answer3" class="radio"></label>
                            </li>
                        </ul>
                    </li>
                    <li class="quizItem">
                        <ul class="quizFlex">
                            <li class="quizAnswer">
                                <input type="radio" id="answer4" name="movieAnswer" value="The Two Towers">
                                <label for="answer4" class="radio">The Two Towers</label>
                            </li>
                            <li class="quizAnswer">
                                <input type="radio" id="answer5" name="movieAnswer" value="The Fellowship of the Ring">
                                <label for="answer5" class="radio">The Fellowship of the Ring</label>
                            </li>
                            <li class="quizAnswer">
                                <input type="radio" id="answer6" name="movieAnswer" value="The Return of the King">
                                <label for="answer6" class="radio">The Return of the King</label>
                            </li>
                        </ul>
                    </li>
                </ul>
                <button type="submit" id="quizButton" class="quiz-button">volgende vraag</button>
            </form>
            <ul id="countButton">
                <li id="questionCounter"></li>
                <article class="thumbsButton">
                    <form action="/thumbsAction" method="POST" style="display: inline;">
                        <input type="hidden" name="thumbsUp" value="favoriet">
                        <input type="hidden" name="username" value="">
                        <input type="hidden" name="quoteData" value=''>
                        <button id="thumbsUp"></button>
                    </form>
                    <form action="/thumbsAction" method="POST" style="display: inline;">
                        <input type="hidden" name="thumbsDown" value="blacklist">
                        <input type="hidden" name="username" value="">
                        <input type="hidden" name="quoteId" value=''>
                        <input type="hidden" name="reason" value="Some reason">
                        <button id="thumbsDown"></button>
                    </form>
                </article>
            </ul>
        </section>
        <section id="quizRight"></section>
    </main>

    <footer>
        &copy; Copyright WPL Projects 2024-2025
    </footer>
</body>

</html>